{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:mvp:notification-api:v1",
  "title": "Open Android Intelligence notification API",
  "unevaluatedProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/query" },
    { "$ref": "#/$defs/subscribe" },
    { "$ref": "#/$defs/unsubscribe" },
    { "$ref": "#/$defs/query_response" },
    { "$ref": "#/$defs/subscription_response" }
  ],
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$"
    },
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "mode", "operation_id", "policy_revision", "limit"],
      "properties": {
        "operation": { "const": "mobile.notifications.query" },
        "mode": { "enum": ["on_demand", "auto_send"] },
        "operation_id": { "type": "string", "minLength": 1 },
        "policy_revision": { "$ref": "#/$defs/u64" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "packages": { "$ref": "#/$defs/packages" },
        "content": { "enum": ["metadata", "content"] }
      }
    },
    "subscribe": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "subscription_id", "policy_revision"],
      "properties": {
        "operation": { "const": "mobile.notifications.subscribe" },
        "subscription_id": { "type": "string", "minLength": 1 },
        "policy_revision": { "$ref": "#/$defs/u64" },
        "packages": { "$ref": "#/$defs/packages" },
        "content": { "enum": ["metadata", "content"] }
      }
    },
    "unsubscribe": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "subscription_id", "policy_revision"],
      "properties": {
        "operation": { "const": "mobile.notifications.unsubscribe" },
        "subscription_id": { "type": "string", "minLength": 1 },
        "policy_revision": { "$ref": "#/$defs/u64" }
      }
    },
    "packages": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$" },
      "x-open-android-intelligence-order": "strictly Unicode-code-point sorted"
    },
    "query_response": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "policy_revision", "records"],
      "properties": {
        "status": { "enum": ["complete", "waiting_device", "failed"] },
        "policy_revision": { "$ref": "#/$defs/u64" },
        "records": { "type": "array", "items": { "$ref": "urn:open-android-intelligence:mvp:notification-record:v1" } },
        "error": { "type": ["string", "null"] }
      }
    },
    "subscription_response": {
      "type": "object", "additionalProperties": false,
      "required": ["subscription_id", "removed"],
      "properties": {
        "subscription_id": { "type": "string", "minLength": 1 },
        "removed": { "type": "boolean" }
      }
    }
  }
}
