{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:mvp:sms-api:v1",
  "title": "Open Android Intelligence SMS API",
  "unevaluatedProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/query" },
    { "$ref": "#/$defs/subscribe" },
    { "$ref": "#/$defs/unsubscribe" }
  ],
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["operation", "operation_id", "policy_revision", "limit"],
      "properties": {
        "operation": { "const": "mobile.sms.query" },
        "operation_id": { "type": "string", "minLength": 1 },
        "policy_revision": { "$ref": "#/$defs/u64" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "subscribe": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["operation", "subscription_id", "policy_revision"],
      "properties": {
        "operation": { "const": "mobile.sms.subscribe" },
        "subscription_id": { "type": "string", "minLength": 1 },
        "policy_revision": { "$ref": "#/$defs/u64" }
      }
    },
    "unsubscribe": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["operation", "subscription_id", "policy_revision"],
      "properties": {
        "operation": { "const": "mobile.sms.unsubscribe" },
        "subscription_id": { "type": "string", "minLength": 1 },
        "policy_revision": { "$ref": "#/$defs/u64" }
      }
    }
  }
}
