{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:mvp:notification-policy:v1",
  "title": "Open Android Intelligence notification collection policy",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$"
    }
  },
  "required": ["mode", "package_ids", "field_access", "policy_revision"],
  "properties": {
    "mode": { "type": "string", "enum": ["allowlist", "denylist"] },
    "package_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$" }
    },
    "field_access": { "type": "string", "enum": ["metadata", "content"] },
    "policy_revision": { "$ref": "#/$defs/u64" }
  },
  "x-open-android-intelligence-order": "package_ids are strictly Unicode-code-point sorted; revisions are monotonic decimal u64"
}
