{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:mvp:call-record:v1",
  "title": "Open Android Intelligence call record",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": ["kind", "record_id", "source_epoch", "record_revision", "cursor_started_at_epoch_ms", "cursor_provider_id", "captured_at_epoch_ms", "capture_revision", "policy_revision", "metadata", "counterparty_number"],
  "properties": {
    "kind": { "const": "upsert" },
    "record_id": { "$ref": "#/$defs/call_record_id" },
    "source_epoch": { "$ref": "#/$defs/positive_u64" },
    "record_revision": { "const": "1" },
    "cursor_started_at_epoch_ms": { "$ref": "#/$defs/nonnegative_i64" },
    "cursor_provider_id": { "$ref": "#/$defs/positive_i64" },
    "captured_at_epoch_ms": { "$ref": "#/$defs/nonnegative_i64" },
    "capture_revision": { "$ref": "#/$defs/u64" },
    "policy_revision": { "$ref": "#/$defs/u64" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "counterparty_number": { "$ref": "#/$defs/counterparty_number" }
  },
  "$defs": {
    "call_record_id": { "type": "string", "pattern": "^call:([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$" },
    "positive_i64": { "type": "string", "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$" },
    "nonnegative_i64": { "anyOf": [{ "const": "0" }, { "$ref": "#/$defs/positive_i64" }] },
    "u64": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$" },
    "positive_u64": { "type": "string", "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$" },
    "metadata": {
      "type": "object", "additionalProperties": false, "unevaluatedProperties": false,
      "required": ["direction", "started_at_epoch_ms", "ended_at_epoch_ms", "duration_seconds", "observed_at_epoch_ms", "number_presentation"],
      "properties": {
        "direction": { "enum": ["incoming", "outgoing", "missed", "rejected"] },
        "started_at_epoch_ms": { "$ref": "#/$defs/nonnegative_i64" }, "ended_at_epoch_ms": { "$ref": "#/$defs/nonnegative_i64" },
        "duration_seconds": { "$ref": "#/$defs/nonnegative_i64" }, "observed_at_epoch_ms": { "$ref": "#/$defs/nonnegative_i64" },
        "number_presentation": { "enum": ["allowed", "restricted", "unknown", "payphone", "unavailable"] }
      }
    },
    "counterparty_number": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "unevaluatedProperties": false, "required": ["state"], "properties": { "state": { "const": "withheld" } } },
        { "type": "object", "additionalProperties": false, "unevaluatedProperties": false, "required": ["state", "value"], "properties": { "state": { "const": "released" }, "value": { "type": "string", "minLength": 1, "description": "UTF-8 byte length is constrained by the executable open-android-intelligence contract extension, not JSON Schema maxLength code points.", "x-open-android-intelligence-maxUtf8Bytes": 256 } } }
      ]
    }
  }
}
