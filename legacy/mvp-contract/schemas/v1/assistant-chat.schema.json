{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:mvp:assistant-chat:v1",
  "title": "Open Android Intelligence assistant chat",
  "unevaluatedProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "artifact_id": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$" },
    "image_attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "artifact_id", "media_type", "byte_length", "sha256", "display_name"],
      "properties": {
        "kind": { "const": "image" },
        "artifact_id": { "$ref": "#/$defs/artifact_id" },
        "media_type": { "enum": ["image/jpeg", "image/png", "image/webp"] },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 26214400 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$" }
      }
    },
    "file_attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "artifact_id", "media_type", "byte_length", "sha256", "display_name"],
      "properties": {
        "kind": { "const": "file" },
        "artifact_id": { "$ref": "#/$defs/artifact_id" },
        "media_type": { "enum": ["application/pdf", "text/plain"] },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 26214400 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$" }
      }
    },
    "audio_attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "artifact_id", "media_type", "byte_length", "sha256", "display_name", "duration_ms"],
      "properties": {
        "kind": { "const": "audio" },
        "artifact_id": { "$ref": "#/$defs/artifact_id" },
        "media_type": { "const": "audio/mp4" },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 10485760 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$" },
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "attachment": { "oneOf": [ { "$ref": "#/$defs/image_attachment" }, { "$ref": "#/$defs/file_attachment" }, { "$ref": "#/$defs/audio_attachment" } ] },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "operation_id", "text", "attachments"],
      "properties": {
        "kind": { "const": "request" }, "operation_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "maxLength": 50000 },
        "attachments": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/attachment" } }
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "operation_id", "text", "status"],
      "properties": {
        "kind": { "const": "response" }, "operation_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "maxLength": 50000 }, "status": { "enum": ["complete", "failed"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "operation_id", "message_id", "sequence", "event", "text"],
      "properties": {
        "kind": { "const": "event" }, "operation_id": { "type": "string", "minLength": 1 },
        "message_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "string", "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]|1844674407370955161[0-4]|18446744073709551615)$" },
        "event": { "enum": ["delta", "complete", "failed"] }, "text": { "type": "string", "maxLength": 50000 },
        "error": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "event": { "const": "failed" } } }, "then": { "required": ["error"] } },
        { "if": { "properties": { "event": { "enum": ["delta", "complete"] } } }, "then": { "not": { "required": ["error"] } } }
      ]
    }
  }
}
