{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:mvp:notification-record:v1",
  "title": "Open Android Intelligence notification event",
  "unevaluatedProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/upsert" },
    { "$ref": "#/$defs/delete_tombstone" },
    { "$ref": "#/$defs/loss_marker" }
  ],
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$"
    },
    "positive_u64": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_name", "app_label", "channel_id", "posted_at_epoch_ms"],
      "properties": {
        "package_name": { "type": "string", "minLength": 1 },
        "app_label": { "type": ["string", "null"] },
        "channel_id": { "type": ["string", "null"] },
        "posted_at_epoch_ms": { "$ref": "#/$defs/u64" }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "body": { "type": ["string", "null"] }
      }
    },
    "loss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lost_from_cursor", "lost_to_cursor", "reason"],
      "properties": {
        "lost_from_cursor": { "$ref": "#/$defs/positive_u64" },
        "lost_to_cursor": { "$ref": "#/$defs/positive_u64" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "upsert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_epoch", "occurrence_id", "record_key", "record_revision", "cursor", "captured_at_epoch_ms", "capture_revision", "metadata", "content", "loss"],
      "properties": {
        "kind": { "const": "upsert" },
        "source_epoch": { "$ref": "#/$defs/u64" },
        "occurrence_id": { "type": "string", "minLength": 1 },
        "record_key": { "type": "string", "minLength": 1 },
        "record_revision": { "$ref": "#/$defs/positive_u64" },
        "cursor": { "$ref": "#/$defs/positive_u64" },
        "captured_at_epoch_ms": { "$ref": "#/$defs/u64" },
        "capture_revision": { "$ref": "#/$defs/u64" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "content": { "anyOf": [{ "$ref": "#/$defs/content" }, { "type": "null" }] },
        "loss": { "type": "null" }
      }
    },
    "delete_tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_epoch", "occurrence_id", "record_key", "record_revision", "cursor", "captured_at_epoch_ms", "capture_revision", "metadata", "content", "loss"],
      "properties": {
        "kind": { "const": "delete_tombstone" },
        "source_epoch": { "$ref": "#/$defs/u64" },
        "occurrence_id": { "type": "string", "minLength": 1 },
        "record_key": { "type": "string", "minLength": 1 },
        "record_revision": { "$ref": "#/$defs/positive_u64" },
        "cursor": { "$ref": "#/$defs/positive_u64" },
        "captured_at_epoch_ms": { "$ref": "#/$defs/u64" },
        "capture_revision": { "$ref": "#/$defs/u64" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "content": { "type": "null" },
        "loss": { "type": "null" }
      }
    },
    "loss_marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_epoch", "occurrence_id", "record_key", "record_revision", "cursor", "captured_at_epoch_ms", "capture_revision", "metadata", "content", "loss"],
      "properties": {
        "kind": { "const": "loss_marker" },
        "source_epoch": { "$ref": "#/$defs/u64" },
        "occurrence_id": { "type": "string", "minLength": 1 },
        "record_key": { "type": "string", "minLength": 1 },
        "record_revision": { "$ref": "#/$defs/positive_u64" },
        "cursor": { "$ref": "#/$defs/positive_u64" },
        "captured_at_epoch_ms": { "$ref": "#/$defs/u64" },
        "capture_revision": { "$ref": "#/$defs/u64" },
        "metadata": { "type": "null" },
        "content": { "type": "null" },
        "loss": { "$ref": "#/$defs/loss" }
      }
    }
  }
}
