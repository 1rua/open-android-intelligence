{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:protocol:v1:errors-registry",
  "type": "object",
  "required": ["$schema", "registry_id", "protocol_version", "errors"],
  "properties": {
    "$schema": { "const": "urn:open-android-intelligence:protocol:v1:errors-registry" },
    "registry_id": { "const": "urn:open-android-intelligence:protocol:v1:registry:errors" },
    "protocol_version": { "const": "1.0" },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" }, "minItems": 1 }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "error": {
      "type": "object",
      "required": ["code", "stage", "retryable", "operation_reason", "internal_reason"],
      "properties": {
        "code": { "enum": ["SCHEMA_INVALID", "MESSAGE_TOO_LARGE", "MESSAGE_EXPIRED", "CONNECTION_FENCED", "AUTH_FAILED", "INTEGRITY_FAILED", "NOT_AUTHORIZED", "REPLAY_REJECTED", "SECURITY_LEDGER_FULL", "FLOW_CONTROL_VIOLATION", "RATE_LIMITED", "INVALID_STATE_TRANSITION", "RESULT_CONFLICT"] },
        "stage": { "enum": ["size", "canonical_schema", "key_direction_domain_signature", "payload_digest", "expiry", "connection_fence", "authenticated_binding", "authorization_revision", "replay", "operation_transition", "execution_ledger"] },
        "retryable": { "type": "boolean" },
        "operation_reason": { "oneOf": [{ "enum": ["NOT_AUTHORIZED", "POLICY_BLOCKED", "USER_DENIED", "PLATFORM_UNSUPPORTED", "BACKEND_UNAVAILABLE", "DEVICE_OFFLINE", "DEVICE_LOCKED", "PAYLOAD_TOO_LARGE", "RATE_LIMITED", "SECURITY_LEDGER_FULL", "QUEUE_LIMIT", "INTERNAL_ERROR"] }, { "type": "null" }] },
        "internal_reason": { "oneOf": [{ "enum": ["PENDING_LIMIT", "COOLDOWN", "CREDIT_EXHAUSTED", "RESULT_CONFLICT", "NONE"] }, { "type": "null" }] }
      },
      "unevaluatedProperties": false
    }
  }
}
