{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:protocol:v1:profile",
  "title": "Open Android Intelligence protocol profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "protocol_version",
    "canonicalization",
    "canonicalization_version",
    "text_encoding",
    "signature_preimage_layout",
    "signature_domains",
    "digest",
    "signature",
    "curve",
    "signature_encoding",
    "signature_low_s",
    "base64url_policy",
    "timestamp_format",
    "wire_id_format",
    "server_id_format",
    "integer_format",
    "max_envelope_bytes",
    "max_clock_skew_seconds",
    "replay_window_size",
    "key_rotation_grace_seconds",
    "wait_read_max_seconds",
    "channel_ticket_lifetime_seconds",
    "artifact_chunk_min_bytes",
    "artifact_chunk_default_bytes",
    "artifact_chunk_max_bytes",
    "artifact_max_files_per_message",
    "artifact_max_file_bytes",
    "artifact_max_message_bytes",
    "artifact_orphan_lifetime_seconds"
  ],
  "properties": {
    "profile_id": { "const": "open-android-intelligence-json-es256/1.0" },
    "protocol_version": { "const": "1.0" },
    "canonicalization": { "const": "RFC8785-JCS" },
    "canonicalization_version": { "const": "RFC 8785" },
    "text_encoding": { "const": "UTF-8" },
    "signature_preimage_layout": { "const": "domain-prefix-nul-u32be-jcs" },
    "signature_domains": {
      "const": [
        "enrollment/app-to-bridge",
        "enrollment/bridge-to-app",
        "control/app-to-bridge",
        "control/bridge-to-app",
        "adapter/adapter-to-bridge",
        "adapter/bridge-to-adapter",
        "key-rotation/app-to-bridge",
        "key-rotation/bridge-to-app",
        "key-rotation/adapter-to-bridge",
        "key-rotation/bridge-to-adapter",
        "migration/bridge",
        "approval/device",
        "ticket/bridge",
        "receipt/device",
        "channel-pop/device",
        "channel-pop/adapter"
      ]
    },
    "digest": { "const": "SHA-256" },
    "signature": { "const": "ES256" },
    "curve": { "const": "P-256" },
    "signature_encoding": { "const": "IEEE-P1363-64" },
    "signature_low_s": { "const": true },
    "base64url_policy": { "const": "RFC4648-URLSAFE-NO-PADDING-CANONICAL" },
    "timestamp_format": { "const": "rfc3339-utc-milliseconds" },
    "wire_id_format": { "const": "lowercase-uuid-v4" },
    "server_id_format": { "const": "opaque-server-id" },
    "integer_format": { "const": "decimal-u64" },
    "max_envelope_bytes": { "$ref": "#/$defs/decimalU64", "const": "262144" },
    "max_clock_skew_seconds": { "$ref": "#/$defs/decimalU64", "const": "60" },
    "replay_window_size": { "$ref": "#/$defs/decimalU64", "const": "1024" },
    "key_rotation_grace_seconds": { "$ref": "#/$defs/decimalU64", "const": "900" },
    "wait_read_max_seconds": { "$ref": "#/$defs/decimalU64", "const": "900" },
    "channel_ticket_lifetime_seconds": { "$ref": "#/$defs/decimalU64", "const": "300" },
    "artifact_chunk_min_bytes": { "$ref": "#/$defs/decimalU64", "const": "65536" },
    "artifact_chunk_default_bytes": { "$ref": "#/$defs/decimalU64", "const": "262144" },
    "artifact_chunk_max_bytes": { "$ref": "#/$defs/decimalU64", "const": "1048576" },
    "artifact_max_files_per_message": { "$ref": "#/$defs/decimalU64", "const": "4" },
    "artifact_max_file_bytes": { "$ref": "#/$defs/decimalU64", "const": "26214400" },
    "artifact_max_message_bytes": { "$ref": "#/$defs/decimalU64", "const": "52428800" },
    "artifact_orphan_lifetime_seconds": { "$ref": "#/$defs/decimalU64", "const": "86400" }
  },
  "$defs": {
    "decimalU64": {
      "type": "string",
      "format": "decimal-u64"
    }
  }
}
