{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:protocol:v1:control-envelope",
  "type": "object",
  "unevaluatedProperties": false,
  "$defs": {
    "device_ping": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:device_ping",
      "type": "object",
      "required": ["challenge"],
      "properties": { "challenge": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/b64u32" } },
      "unevaluatedProperties": false
    },
    "bridge_ping": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:bridge_ping",
      "type": "object",
      "required": ["challenge"],
      "properties": { "challenge": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/b64u32" } },
      "unevaluatedProperties": false
    },
    "device_presence": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:device_presence",
      "type": "object",
      "required": ["state"],
      "properties": { "state": { "enum": ["online", "idle"] } },
      "unevaluatedProperties": false
    },
    "paired_device_family_header": {
      "type": "object",
      "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/signed_header_base" },
        {
          "type": "object",
          "required": ["device_id", "pairing_generation", "connection_generation"],
          "properties": {
            "device_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
            "pairing_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" },
            "connection_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "paired_device_family_envelope": {
      "type": "object",
      "required": ["header", "payload", "signature"],
      "properties": {
        "header": { "$ref": "urn:open-android-intelligence:protocol:v1:control-envelope#/$defs/paired_device_family_header" },
        "payload": { "type": "object" },
        "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" }
      },
      "unevaluatedProperties": false
    },
    "device_ping_header": {
      "$id": "urn:open-android-intelligence:protocol:v1:header:device_ping",
      "type": "object",
      "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:control-envelope#/$defs/paired_device_family_header" },
        { "type": "object", "properties": { "message_type": { "const": "device_ping" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:device_ping" }, "direction": { "const": "app-to-bridge" } } }
      ],
      "unevaluatedProperties": false
    },
    "bridge_ping_header": {
      "$id": "urn:open-android-intelligence:protocol:v1:header:bridge_ping",
      "type": "object",
      "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:control-envelope#/$defs/paired_device_family_header" },
        { "type": "object", "properties": { "message_type": { "const": "bridge_ping" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:bridge_ping" }, "direction": { "const": "bridge-to-app" } } }
      ],
      "unevaluatedProperties": false
    },
    "device_presence_header": {
      "$id": "urn:open-android-intelligence:protocol:v1:header:device_presence",
      "type": "object",
      "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:control-envelope#/$defs/paired_device_family_header" },
        { "type": "object", "properties": { "message_type": { "const": "device_presence" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:device_presence" }, "direction": { "const": "app-to-bridge" } } }
      ],
      "unevaluatedProperties": false
    },
    "device_ping_envelope": {
      "$id": "urn:open-android-intelligence:protocol:v1:envelope:device_ping",
      "type": "object", "required": ["header", "payload", "signature"],
      "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:header:device_ping" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:device_ping" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } },
      "unevaluatedProperties": false
    },
    "bridge_ping_envelope": {
      "$id": "urn:open-android-intelligence:protocol:v1:envelope:bridge_ping",
      "type": "object", "required": ["header", "payload", "signature"],
      "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:header:bridge_ping" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:bridge_ping" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } },
      "unevaluatedProperties": false
    },
    "device_presence_envelope": {
      "$id": "urn:open-android-intelligence:protocol:v1:envelope:device_presence",
      "type": "object", "required": ["header", "payload", "signature"],
      "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:header:device_presence" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:device_presence" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } },
      "unevaluatedProperties": false
    }
  }
}
