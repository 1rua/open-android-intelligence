{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:protocol:v1:connect",
  "type": "object",
  "unevaluatedProperties": false,
  "$defs": {
    "version_array": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/protocol_version" } },
    "connect_hello": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:connect_hello", "type": "object",
      "required": ["client_nonce", "supported_versions", "last_manifest_generation", "last_event_cursor"],
      "properties": { "client_nonce": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/b64u32" }, "supported_versions": { "$ref": "urn:open-android-intelligence:protocol:v1:connect#/$defs/version_array" }, "last_manifest_generation": { "anyOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" }, { "type": "null" }] }, "last_event_cursor": { "anyOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, { "type": "null" }] } },
      "unevaluatedProperties": false
    },
    "command_key_set": {
      "type": "object", "required": ["current", "next"],
      "properties": { "current": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p256_public_jwk" }, "next": { "anyOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p256_public_jwk" }, { "type": "null" }] } }, "unevaluatedProperties": false
    },
    "connect_welcome": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:connect_welcome", "type": "object",
      "required": ["client_offer_digest", "client_nonce", "bridge_nonce", "selected_protocol", "bridge_time", "command_key_set", "connection_generation"],
      "properties": { "client_offer_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" }, "client_nonce": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/b64u32" }, "bridge_nonce": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/b64u32" }, "selected_protocol": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/protocol_version" }, "bridge_time": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" }, "command_key_set": { "$ref": "urn:open-android-intelligence:protocol:v1:connect#/$defs/command_key_set" }, "connection_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } },
      "unevaluatedProperties": false
    },
    "hello_header": {
      "$id": "urn:open-android-intelligence:protocol:v1:header:connect_hello", "type": "object", "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/signed_header_base" },
        { "type": "object", "required": ["device_id", "pairing_generation"], "properties": { "message_type": { "const": "connect_hello" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:connect_hello" }, "direction": { "const": "app-to-bridge" }, "device_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "pairing_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } } }
      ], "unevaluatedProperties": false
    },
    "welcome_header": {
      "$id": "urn:open-android-intelligence:protocol:v1:header:connect_welcome", "type": "object", "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/signed_header_base" },
        { "type": "object", "required": ["device_id", "pairing_generation"], "properties": { "message_type": { "const": "connect_welcome" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:connect_welcome" }, "direction": { "const": "bridge-to-app" }, "device_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "pairing_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } } }
      ], "unevaluatedProperties": false
    },
    "hello_envelope": {
      "$id": "urn:open-android-intelligence:protocol:v1:envelope:connect_hello", "type": "object", "required": ["header", "payload", "signature"],
      "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:header:connect_hello" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:connect_hello" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false
    },
    "welcome_envelope": {
      "$id": "urn:open-android-intelligence:protocol:v1:envelope:connect_welcome", "type": "object", "required": ["header", "payload", "signature"],
      "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:header:connect_welcome" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:connect_welcome" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false
    }
  }
}
