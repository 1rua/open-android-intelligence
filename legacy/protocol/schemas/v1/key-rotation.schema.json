{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:protocol:v1:key-rotation",
  "type": "object",
  "unevaluatedProperties": false,
  "$defs": {
    "proposal_base": {
      "type": "object",
      "required": ["rotation_id", "old_key_id", "new_public_jwk", "new_key_thumbprint", "challenge"],
      "properties": {
        "rotation_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/lowercase_uuid_v4" },
        "old_key_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "new_public_jwk": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p256_public_jwk" },
        "new_key_thumbprint": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" },
        "challenge": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/b64u32" }
      }
    },
    "ack_base": {
      "type": "object",
      "required": ["rotation_id", "old_key_id", "new_key_id", "new_key_thumbprint", "challenge", "proposal_digest"],
      "properties": {
        "rotation_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/lowercase_uuid_v4" },
        "old_key_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "new_key_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "new_key_thumbprint": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" },
        "challenge": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/b64u32" },
        "proposal_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" }
      }
    },
    "device_key_rotation": { "$id": "urn:open-android-intelligence:protocol:v1:message:device_key_rotation", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:key-rotation#/$defs/proposal_base" }], "unevaluatedProperties": false },
    "device_key_rotation_ack": { "$id": "urn:open-android-intelligence:protocol:v1:message:device_key_rotation_ack", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:key-rotation#/$defs/ack_base" }], "unevaluatedProperties": false },
    "bridge_key_rotation": { "$id": "urn:open-android-intelligence:protocol:v1:message:bridge_key_rotation", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:key-rotation#/$defs/proposal_base" }], "unevaluatedProperties": false },
    "bridge_key_rotation_ack": { "$id": "urn:open-android-intelligence:protocol:v1:message:bridge_key_rotation_ack", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:key-rotation#/$defs/ack_base" }], "unevaluatedProperties": false },
    "adapter_key_rotation": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:adapter_key_rotation",
      "type": "object",
      "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:key-rotation#/$defs/proposal_base" }, { "type": "object", "required": ["next_adapter_credential_generation"], "properties": { "next_adapter_credential_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } } }],
      "unevaluatedProperties": false
    },
    "adapter_key_rotation_ack": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:adapter_key_rotation_ack",
      "type": "object",
      "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:key-rotation#/$defs/ack_base" }, { "type": "object", "required": ["next_adapter_credential_generation"], "properties": { "next_adapter_credential_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } } }],
      "unevaluatedProperties": false
    },
    "adapter_family_header": {
      "type": "object",
      "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/signed_header_base" },
        { "type": "object", "required": ["adapter_credential_id", "adapter_credential_generation"], "properties": { "adapter_credential_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "adapter_credential_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } } }
      ],
      "unevaluatedProperties": false
    },
    "adapter_family_envelope": {
      "type": "object", "required": ["header", "payload", "signature"],
      "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:key-rotation#/$defs/adapter_family_header" }, "payload": { "type": "object" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } },
      "unevaluatedProperties": false
    },
    "device_key_rotation_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:device_key_rotation", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:control-envelope#/$defs/paired_device_family_header" }, { "type": "object", "properties": { "message_type": { "const": "device_key_rotation" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:device_key_rotation" }, "direction": { "const": "app-to-bridge" } } }], "unevaluatedProperties": false },
    "device_key_rotation_ack_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:device_key_rotation_ack", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:control-envelope#/$defs/paired_device_family_header" }, { "type": "object", "properties": { "message_type": { "const": "device_key_rotation_ack" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:device_key_rotation_ack" }, "direction": { "const": "bridge-to-app" } } }], "unevaluatedProperties": false },
    "bridge_key_rotation_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:bridge_key_rotation", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:control-envelope#/$defs/paired_device_family_header" }, { "type": "object", "properties": { "message_type": { "const": "bridge_key_rotation" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:bridge_key_rotation" }, "direction": { "const": "bridge-to-app" } } }], "unevaluatedProperties": false },
    "bridge_key_rotation_ack_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:bridge_key_rotation_ack", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:control-envelope#/$defs/paired_device_family_header" }, { "type": "object", "properties": { "message_type": { "const": "bridge_key_rotation_ack" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:bridge_key_rotation_ack" }, "direction": { "const": "app-to-bridge" } } }], "unevaluatedProperties": false },
    "adapter_key_rotation_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:adapter_key_rotation", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:key-rotation#/$defs/adapter_family_header" }, { "type": "object", "properties": { "message_type": { "const": "adapter_key_rotation" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:adapter_key_rotation" }, "direction": { "const": "adapter-to-bridge" } } }], "unevaluatedProperties": false },
    "adapter_key_rotation_ack_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:adapter_key_rotation_ack", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:key-rotation#/$defs/adapter_family_header" }, { "type": "object", "properties": { "message_type": { "const": "adapter_key_rotation_ack" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:adapter_key_rotation_ack" }, "direction": { "const": "bridge-to-adapter" } } }], "unevaluatedProperties": false },
    "device_key_rotation_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:device_key_rotation", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:header:device_key_rotation" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:device_key_rotation" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "device_key_rotation_ack_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:device_key_rotation_ack", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:header:device_key_rotation_ack" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:device_key_rotation_ack" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "bridge_key_rotation_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:bridge_key_rotation", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:header:bridge_key_rotation" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:bridge_key_rotation" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "bridge_key_rotation_ack_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:bridge_key_rotation_ack", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:header:bridge_key_rotation_ack" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:bridge_key_rotation_ack" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "adapter_key_rotation_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:adapter_key_rotation", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:header:adapter_key_rotation" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:adapter_key_rotation" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "adapter_key_rotation_ack_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:adapter_key_rotation_ack", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:header:adapter_key_rotation_ack" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:adapter_key_rotation_ack" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false }
  }
}
