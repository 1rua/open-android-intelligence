{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:protocol:v1:common",
  "type": "object",
  "unevaluatedProperties": false,
  "$defs": {
    "decimal_u64": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "format": "decimal-u64" },
    "lowercase_uuid_v4": { "type": "string", "format": "lowercase-uuid-v4" },
    "opaque_server_id": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$" },
    "b64u": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "b64u32": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$", "format": "base64url-32" },
    "p1363_signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$", "format": "base64url-64" },
    "sha256_b64u": { "$ref": "#/$defs/b64u32" },
    "timestamp": { "type": "string", "format": "rfc3339-utc-milliseconds" },
    "protocol_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "scope": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "p256_public_jwk": {
      "type": "object",
      "required": ["alg", "crv", "kid", "kty", "use", "x", "y"],
      "properties": {
        "alg": { "const": "ES256" },
        "crv": { "const": "P-256" },
        "kid": { "$ref": "#/$defs/opaque_server_id" },
        "kty": { "const": "EC" },
        "use": { "const": "sig" },
        "x": { "$ref": "#/$defs/b64u32" },
        "y": { "$ref": "#/$defs/b64u32" }
      },
      "unevaluatedProperties": false
    },
    "revision_snapshot": {
      "type": "object",
      "required": ["pairing_generation", "authorization_epoch", "scope_revisions"],
      "properties": {
        "pairing_generation": { "$ref": "#/$defs/decimal_u64" },
        "authorization_epoch": { "$ref": "#/$defs/decimal_u64" },
        "scope_revisions": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
          "additionalProperties": { "$ref": "#/$defs/decimal_u64" }
        }
      },
      "unevaluatedProperties": false
    },
    "signed_header_base": {
      "type": "object",
      "required": ["protocol_version", "message_schema", "message_type", "message_id", "key_id", "direction", "sequence", "issued_at", "expires_at", "payload_digest"],
      "properties": {
        "protocol_version": { "const": "1.0" },
        "message_schema": { "type": "string", "pattern": "^urn:open-android-intelligence:protocol:v1:message:[a-z][a-z0-9_]*$" },
        "message_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "message_id": { "$ref": "#/$defs/lowercase_uuid_v4" },
        "key_id": { "$ref": "#/$defs/opaque_server_id" },
        "direction": { "enum": ["app-to-bridge", "bridge-to-app", "adapter-to-bridge", "bridge-to-adapter"] },
        "sequence": { "$ref": "#/$defs/decimal_u64" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "payload_digest": { "$ref": "#/$defs/sha256_b64u" }
      }
    }
  }
}
