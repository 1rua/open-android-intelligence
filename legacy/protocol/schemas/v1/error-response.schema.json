{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:protocol:v1:error-response",
  "type": "object",
  "required": ["code", "stage", "correlation_message_id", "retry_after"],
  "properties": {
    "code": { "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/code" },
    "stage": { "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/stage" },
    "correlation_message_id": { "oneOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/lowercase_uuid_v4" }, { "type": "null" }] },
    "retry_after": { "oneOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" }, { "type": "null" }] }
  },
  "oneOf": [
    { "properties": { "code": { "enum": ["RATE_LIMITED", "FLOW_CONTROL_VIOLATION", "SECURITY_LEDGER_FULL"] }, "retry_after": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } } },
    { "properties": { "code": { "enum": ["SCHEMA_INVALID", "MESSAGE_TOO_LARGE", "MESSAGE_EXPIRED", "CONNECTION_FENCED", "AUTH_FAILED", "INTEGRITY_FAILED", "NOT_AUTHORIZED", "REPLAY_REJECTED", "INVALID_STATE_TRANSITION", "RESULT_CONFLICT"] }, "retry_after": { "type": "null" } } }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "error_payload": {
      "type": "object",
      "required": ["code", "stage", "correlation_message_id", "retry_after"],
      "properties": {
        "code": { "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/code" },
        "stage": { "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/stage" },
        "correlation_message_id": { "oneOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/lowercase_uuid_v4" }, { "type": "null" }] },
        "retry_after": { "oneOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" }, { "type": "null" }] }
      },
      "oneOf": [
        { "properties": { "code": { "enum": ["RATE_LIMITED", "FLOW_CONTROL_VIOLATION", "SECURITY_LEDGER_FULL"] }, "retry_after": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } } },
        { "properties": { "code": { "enum": ["SCHEMA_INVALID", "MESSAGE_TOO_LARGE", "MESSAGE_EXPIRED", "CONNECTION_FENCED", "AUTH_FAILED", "INTEGRITY_FAILED", "NOT_AUTHORIZED", "REPLAY_REJECTED", "INVALID_STATE_TRANSITION", "RESULT_CONFLICT"] }, "retry_after": { "type": "null" } } }
      ],
      "unevaluatedProperties": false
    },
    "code": { "enum": ["SCHEMA_INVALID", "MESSAGE_TOO_LARGE", "MESSAGE_EXPIRED", "CONNECTION_FENCED", "AUTH_FAILED", "INTEGRITY_FAILED", "NOT_AUTHORIZED", "REPLAY_REJECTED", "SECURITY_LEDGER_FULL", "FLOW_CONTROL_VIOLATION", "RATE_LIMITED", "INVALID_STATE_TRANSITION", "RESULT_CONFLICT"] },
    "stage": { "enum": ["size", "canonical_schema", "key_direction_domain_signature", "payload_digest", "expiry", "connection_fence", "authenticated_binding", "authorization_revision", "replay", "operation_transition", "execution_ledger"] },
    "device_protocol_error": { "$id": "urn:open-android-intelligence:protocol:v1:message:device_protocol_error", "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/error_payload" },
    "bridge_protocol_error": { "$id": "urn:open-android-intelligence:protocol:v1:message:bridge_protocol_error", "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/error_payload" },
    "adapter_protocol_error": { "$id": "urn:open-android-intelligence:protocol:v1:message:adapter_protocol_error", "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/error_payload" },
    "header_base": {
      "type": "object",
      "required": ["protocol_version", "message_schema", "message_type", "message_id", "key_id", "direction", "sequence", "issued_at", "expires_at", "payload_digest"],
      "properties": {
        "protocol_version": { "const": "1.0" }, "message_schema": { "type": "string", "pattern": "^urn:open-android-intelligence:protocol:v1:message:[a-z][a-z0-9_]*$" }, "message_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "message_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/lowercase_uuid_v4" }, "key_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "direction": { "enum": ["app-to-bridge", "bridge-to-app", "adapter-to-bridge", "bridge-to-adapter"] }, "sequence": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" }, "issued_at": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" }, "expires_at": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" }, "payload_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" }
      }
    },
    "device_header_fields": { "type": "object", "required": ["device_id", "pairing_generation", "connection_generation"], "properties": { "device_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "pairing_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" }, "connection_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } } },
    "adapter_header_fields": { "type": "object", "required": ["adapter_credential_id", "adapter_credential_generation"], "properties": { "adapter_credential_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "adapter_credential_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } } },
    "device_protocol_error_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:device_protocol_error", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/device_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "device_protocol_error" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:device_protocol_error" }, "direction": { "const": "app-to-bridge" } } }], "unevaluatedProperties": false },
    "bridge_protocol_error_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:bridge_protocol_error", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/device_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "bridge_protocol_error" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:bridge_protocol_error" }, "direction": { "const": "bridge-to-app" } } }], "unevaluatedProperties": false },
    "adapter_protocol_error_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:adapter_protocol_error", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/adapter_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "adapter_protocol_error" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:adapter_protocol_error" }, "direction": { "const": "bridge-to-adapter" } } }], "unevaluatedProperties": false },
    "device_protocol_error_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:device_protocol_error", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/device_protocol_error_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:device_protocol_error" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "bridge_protocol_error_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:bridge_protocol_error", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/bridge_protocol_error_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:bridge_protocol_error" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "adapter_protocol_error_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:adapter_protocol_error", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:error-response#/$defs/adapter_protocol_error_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:adapter_protocol_error" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false }
  }
}
