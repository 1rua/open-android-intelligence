{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:protocol:v1:operation",
  "type": "object",
  "required": ["operation_id", "binding", "operation_expires_at", "offline_policy", "state_revision", "state", "reconciliation"],
  "properties": {
    "operation_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
    "binding": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/operation_binding" },
    "operation_expires_at": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" },
    "offline_policy": { "enum": ["WAIT_READ", "FAIL_OFFLINE"] },
    "state_revision": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" },
    "state": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/wire_operation_state" },
    "reconciliation": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/reconciliation" }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "session_or_job": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "session_id", "job_id"],
          "properties": { "kind": { "const": "session" }, "session_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "job_id": { "type": "null" } },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "session_id", "job_id"],
          "properties": { "kind": { "const": "job" }, "session_id": { "type": "null" }, "job_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" } },
          "unevaluatedProperties": false
        }
      ]
    },
    "operation_binding": {
      "type": "object",
      "required": ["tenant_id", "human_principal_id", "agent_principal_id", "agent_instance_id", "workspace_id", "session_or_job", "device_id", "operation_id", "capability", "parameters_digest"],
      "properties": {
        "tenant_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "human_principal_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "agent_principal_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "agent_instance_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "workspace_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "session_or_job": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/session_or_job" },
        "device_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "operation_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "capability": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/scope" },
        "parameters_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" }
      },
      "unevaluatedProperties": false
    },
    "revision_snapshot": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/revision_snapshot" },
    "wire_operation_state": {
      "oneOf": [
        {
          "type": "object",
          "required": ["request_status", "terminal_outcome", "operation_reason"],
          "properties": {
            "request_status": { "enum": ["created", "waiting_device", "dispatching", "accepted_device", "awaiting_approval", "approved", "executing"] },
            "terminal_outcome": { "type": "null" },
            "operation_reason": { "type": "null" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["request_status", "terminal_outcome", "operation_reason"],
          "properties": {
            "request_status": { "type": "null" },
            "terminal_outcome": { "enum": ["succeeded", "failed", "denied", "cancelled", "expired", "result_unknown"] },
            "operation_reason": { "enum": ["NOT_AUTHORIZED", "POLICY_BLOCKED", "USER_DENIED", "PLATFORM_UNSUPPORTED", "BACKEND_UNAVAILABLE", "DEVICE_OFFLINE", "DEVICE_LOCKED", "PAYLOAD_TOO_LARGE", "RATE_LIMITED", "SECURITY_LEDGER_FULL", "QUEUE_LIMIT", "INTERNAL_ERROR", null] }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "reconciliation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["outcome", "evidence_digest", "observed_at"],
          "properties": {
            "outcome": { "enum": ["succeeded", "failed"] },
            "evidence_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" },
            "observed_at": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "adapter_operation_base": {
      "type": "object",
      "required": ["tenant_id", "human_principal_id", "agent_principal_id", "agent_instance_id", "workspace_id", "session_or_job", "device_id", "operation_id"],
      "properties": {
        "tenant_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "human_principal_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "agent_principal_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "agent_instance_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "workspace_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "session_or_job": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/session_or_job" },
        "device_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "operation_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }
      }
    },
    "bound_operation": {
      "type": "object",
      "required": ["tenant_id", "human_principal_id", "agent_principal_id", "agent_instance_id", "workspace_id", "session_or_job", "device_id", "operation_id", "capability", "parameters_digest", "revision_snapshot"],
      "properties": {
        "tenant_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "human_principal_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "agent_principal_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "agent_instance_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "workspace_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "session_or_job": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/session_or_job" },
        "device_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "operation_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "capability": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/scope" },
        "parameters_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" },
        "revision_snapshot": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/revision_snapshot" }
      }
    },
    "operation_submit": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:operation_submit",
      "type": "object",
      "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/adapter_operation_base" },
        {
          "type": "object",
          "required": ["capability", "parameters", "parameters_digest", "revision_snapshot", "operation_expires_at"],
          "properties": {
            "capability": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/scope" },
            "parameters": { "type": "object" },
            "parameters_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" },
            "revision_snapshot": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/revision_snapshot" },
            "operation_expires_at": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "operation_get": { "$id": "urn:open-android-intelligence:protocol:v1:message:operation_get", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/adapter_operation_base" }, { "type": "object" }], "unevaluatedProperties": false },
    "operation_wait": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:operation_wait",
      "type": "object",
      "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/adapter_operation_base" },
        {
          "type": "object",
          "required": ["after_state_revision", "wait_timeout_ms"],
          "properties": {
            "after_state_revision": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" },
            "wait_timeout_ms": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,3}|[12][0-9]{4}|30000)$", "format": "decimal-u64" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "operation_cancel": { "$id": "urn:open-android-intelligence:protocol:v1:message:operation_cancel", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/adapter_operation_base" }, { "type": "object" }], "unevaluatedProperties": false },
    "operation_reconcile": { "$id": "urn:open-android-intelligence:protocol:v1:message:operation_reconcile", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/adapter_operation_base" }, { "type": "object" }], "unevaluatedProperties": false },
    "operation_command": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:operation_command",
      "type": "object",
      "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/bound_operation" },
        {
          "type": "object",
          "required": ["parameters", "operation_expires_at"],
          "properties": { "parameters": { "type": "object" }, "operation_expires_at": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "operation_snapshot": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:operation_snapshot",
      "type": "object",
      "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/bound_operation" },
        {
          "type": "object",
          "required": ["state_revision", "state", "reconciliation"],
          "properties": { "state_revision": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" }, "state": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/wire_operation_state" }, "reconciliation": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/reconciliation" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "header_base": {
      "type": "object",
      "required": ["protocol_version", "message_schema", "message_type", "message_id", "key_id", "direction", "sequence", "issued_at", "expires_at", "payload_digest"],
      "properties": {
        "protocol_version": { "const": "1.0" },
        "message_schema": { "type": "string", "pattern": "^urn:open-android-intelligence:protocol:v1:message:[a-z][a-z0-9_]*$" },
        "message_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "message_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/lowercase_uuid_v4" },
        "key_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "direction": { "enum": ["app-to-bridge", "bridge-to-app", "adapter-to-bridge", "bridge-to-adapter"] },
        "sequence": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" },
        "issued_at": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" },
        "expires_at": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" },
        "payload_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" }
      }
    },
    "adapter_header_fields": {
      "type": "object",
      "required": ["adapter_credential_id", "adapter_credential_generation"],
      "properties": { "adapter_credential_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "adapter_credential_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } }
    },
    "device_header_fields": {
      "type": "object",
      "required": ["device_id", "pairing_generation", "connection_generation"],
      "properties": { "device_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "pairing_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" }, "connection_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } }
    },
    "operation_submit_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:operation_submit", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/adapter_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "operation_submit" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:operation_submit" }, "direction": { "const": "adapter-to-bridge" } } }], "unevaluatedProperties": false },
    "operation_get_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:operation_get", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/adapter_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "operation_get" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:operation_get" }, "direction": { "const": "adapter-to-bridge" } } }], "unevaluatedProperties": false },
    "operation_wait_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:operation_wait", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/adapter_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "operation_wait" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:operation_wait" }, "direction": { "const": "adapter-to-bridge" } } }], "unevaluatedProperties": false },
    "operation_cancel_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:operation_cancel", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/adapter_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "operation_cancel" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:operation_cancel" }, "direction": { "const": "adapter-to-bridge" } } }], "unevaluatedProperties": false },
    "operation_reconcile_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:operation_reconcile", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/adapter_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "operation_reconcile" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:operation_reconcile" }, "direction": { "const": "adapter-to-bridge" } } }], "unevaluatedProperties": false },
    "operation_command_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:operation_command", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/device_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "operation_command" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:operation_command" }, "direction": { "const": "bridge-to-app" } } }], "unevaluatedProperties": false },
    "operation_snapshot_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:operation_snapshot", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/adapter_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "operation_snapshot" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:operation_snapshot" }, "direction": { "const": "bridge-to-adapter" } } }], "unevaluatedProperties": false },
    "operation_submit_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:operation_submit", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/operation_submit_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:operation_submit" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "operation_get_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:operation_get", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/operation_get_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:operation_get" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "operation_wait_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:operation_wait", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/operation_wait_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:operation_wait" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "operation_cancel_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:operation_cancel", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/operation_cancel_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:operation_cancel" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "operation_reconcile_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:operation_reconcile", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/operation_reconcile_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:operation_reconcile" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "operation_command_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:operation_command", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/operation_command_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:operation_command" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "operation_snapshot_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:operation_snapshot", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/operation_snapshot_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:operation_snapshot" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false }
  }
}
