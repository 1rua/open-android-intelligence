{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:protocol:v1:messages-registry",
  "type": "object",
  "required": ["$schema", "registry_id", "protocol_version", "messages"],
  "properties": {
    "$schema": { "const": "urn:open-android-intelligence:protocol:v1:messages-registry" },
    "registry_id": { "const": "urn:open-android-intelligence:protocol:v1:registry:messages" },
    "protocol_version": { "const": "1.0" },
    "messages": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "entry": {
      "type": "object", "required": ["message_type", "direction", "signature_domain", "schema_id"],
      "properties": { "message_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "direction": { "enum": ["app-to-bridge", "bridge-to-app", "adapter-to-bridge", "bridge-to-adapter"] }, "signature_domain": { "type": "string" }, "schema_id": { "type": "string", "pattern": "^urn:open-android-intelligence:protocol:v1:message:[a-z][a-z0-9_]*$" } },
      "unevaluatedProperties": false
    }
  }
}
