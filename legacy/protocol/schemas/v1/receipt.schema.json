{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:protocol:v1:receipt",
  "type": "object",
  "required": ["tenant_id", "human_principal_id", "agent_principal_id", "agent_instance_id", "workspace_id", "session_or_job", "device_id", "operation_id", "capability", "parameters_digest", "revision_snapshot", "state_revision", "state", "reconciliation", "result_digest"],
  "properties": {
    "tenant_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
    "human_principal_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
    "agent_principal_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
    "agent_instance_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
    "workspace_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
    "session_or_job": { "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/session_or_job" },
    "device_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
    "operation_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
    "capability": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/scope" },
    "parameters_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" },
    "revision_snapshot": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/revision_snapshot" },
    "state_revision": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" },
    "state": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/wire_operation_state" },
    "reconciliation": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/reconciliation" },
    "result_digest": { "oneOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" }, { "type": "null" }] },
    "result": { "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/result" }
  },
  "oneOf": [
    { "required": ["result_digest"], "properties": { "result_digest": { "type": "null" }, "result": {} }, "not": { "required": ["result"], "properties": { "result": {} } } },
    { "required": ["result_digest", "result"], "properties": { "result_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" } } }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "session_or_job": {
      "oneOf": [
        { "type": "object", "required": ["kind", "session_id", "job_id"], "properties": { "kind": { "const": "session" }, "session_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "job_id": { "type": "null" } }, "unevaluatedProperties": false },
        { "type": "object", "required": ["kind", "session_id", "job_id"], "properties": { "kind": { "const": "job" }, "session_id": { "type": "null" }, "job_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" } }, "unevaluatedProperties": false }
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "external_side_effect_status"],
          "properties": { "kind": { "const": "system_ui_handoff" }, "external_side_effect_status": { "const": "not_observed" } },
          "unevaluatedProperties": false
        }
      ]
    },
    "bound_operation": {
      "type": "object",
      "required": ["tenant_id", "human_principal_id", "agent_principal_id", "agent_instance_id", "workspace_id", "session_or_job", "device_id", "operation_id", "capability", "parameters_digest", "revision_snapshot"],
      "properties": {
        "tenant_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "human_principal_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "agent_principal_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "agent_instance_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "workspace_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "session_or_job": { "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/session_or_job" },
        "device_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "operation_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
        "capability": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/scope" },
        "parameters_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" },
        "revision_snapshot": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/revision_snapshot" }
      }
    },
    "operation_receipt": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:operation_receipt",
      "type": "object",
      "properties": { "tenant_id": {}, "human_principal_id": {}, "agent_principal_id": {}, "agent_instance_id": {}, "workspace_id": {}, "session_or_job": {}, "device_id": {}, "operation_id": {}, "capability": {}, "parameters_digest": {}, "revision_snapshot": {}, "state_revision": {}, "state": {}, "reconciliation": {}, "result_digest": {}, "result": {} },
      "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/bound_operation" },
        { "type": "object", "required": ["state_revision", "state", "reconciliation", "result_digest"], "properties": { "state_revision": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" }, "state": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/wire_operation_state" }, "reconciliation": { "$ref": "urn:open-android-intelligence:protocol:v1:operation#/$defs/reconciliation" }, "result_digest": { "oneOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" }, { "type": "null" }] }, "result": { "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/result" } } }
      ],
      "oneOf": [
        { "required": ["result_digest"], "properties": { "result_digest": { "type": "null" }, "result": {} }, "not": { "required": ["result"], "properties": { "result": {} } } },
        { "required": ["result_digest", "result"], "properties": { "result_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" } } }
      ],
      "unevaluatedProperties": false
    },
    "operation_receipt_ack": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:operation_receipt_ack",
      "type": "object",
      "properties": { "tenant_id": {}, "human_principal_id": {}, "agent_principal_id": {}, "agent_instance_id": {}, "workspace_id": {}, "session_or_job": {}, "device_id": {}, "operation_id": {}, "capability": {}, "parameters_digest": {}, "revision_snapshot": {}, "receipt_message_id": {}, "receipt_envelope_digest": {}, "accepted_state_revision": {}, "bridge_ack_at": {} },
      "allOf": [
        { "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/bound_operation" },
        { "type": "object", "required": ["receipt_message_id", "receipt_envelope_digest", "accepted_state_revision", "bridge_ack_at"], "properties": { "receipt_message_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/lowercase_uuid_v4" }, "receipt_envelope_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" }, "accepted_state_revision": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" }, "bridge_ack_at": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" } } }
      ],
      "unevaluatedProperties": false
    },
    "receipt_replay": {
      "$id": "urn:open-android-intelligence:protocol:v1:message:receipt_replay",
      "type": "object",
      "required": ["original_receipt_wire_b64", "original_receipt_digest"],
      "properties": { "original_receipt_wire_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 4 }, "original_receipt_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" } },
      "unevaluatedProperties": false
    },
    "header_base": {
      "type": "object",
      "required": ["protocol_version", "message_schema", "message_type", "message_id", "key_id", "direction", "sequence", "issued_at", "expires_at", "payload_digest"],
      "properties": {
        "protocol_version": { "const": "1.0" }, "message_schema": { "type": "string", "pattern": "^urn:open-android-intelligence:protocol:v1:message:[a-z][a-z0-9_]*$" }, "message_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "message_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/lowercase_uuid_v4" }, "key_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "direction": { "enum": ["app-to-bridge", "bridge-to-app", "adapter-to-bridge", "bridge-to-adapter"] }, "sequence": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" }, "issued_at": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" }, "expires_at": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" }, "payload_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" }
      }
    },
    "device_header_fields": { "type": "object", "required": ["device_id", "pairing_generation", "connection_generation"], "properties": { "device_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "pairing_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" }, "connection_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } } },
    "adapter_header_fields": { "type": "object", "required": ["adapter_credential_id", "adapter_credential_generation"], "properties": { "adapter_credential_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" }, "adapter_credential_generation": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/decimal_u64" } } },
    "operation_receipt_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:operation_receipt", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/device_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "operation_receipt" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:operation_receipt" }, "direction": { "const": "app-to-bridge" } } }], "unevaluatedProperties": false },
    "operation_receipt_ack_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:operation_receipt_ack", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/device_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "operation_receipt_ack" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:operation_receipt_ack" }, "direction": { "const": "bridge-to-app" } } }], "unevaluatedProperties": false },
    "receipt_replay_header": { "$id": "urn:open-android-intelligence:protocol:v1:header:receipt_replay", "type": "object", "allOf": [{ "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/header_base" }, { "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/device_header_fields" }, { "type": "object", "properties": { "message_type": { "const": "receipt_replay" }, "message_schema": { "const": "urn:open-android-intelligence:protocol:v1:message:receipt_replay" }, "direction": { "const": "app-to-bridge" } } }], "unevaluatedProperties": false },
    "operation_receipt_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:operation_receipt", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/operation_receipt_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:operation_receipt" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "operation_receipt_ack_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:operation_receipt_ack", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/operation_receipt_ack_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:operation_receipt_ack" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false },
    "receipt_replay_envelope": { "$id": "urn:open-android-intelligence:protocol:v1:envelope:receipt_replay", "type": "object", "required": ["header", "payload", "signature"], "properties": { "header": { "$ref": "urn:open-android-intelligence:protocol:v1:receipt#/$defs/receipt_replay_header" }, "payload": { "$ref": "urn:open-android-intelligence:protocol:v1:message:receipt_replay" }, "signature": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/p1363_signature" } }, "unevaluatedProperties": false }
  }
}
