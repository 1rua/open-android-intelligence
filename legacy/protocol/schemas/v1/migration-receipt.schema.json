{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-android-intelligence:protocol:v1:migration-receipt",
  "type": "object",
  "required": ["migration_id", "source_schema_id", "source_record_digest", "source_signature", "target_schema_id", "target_record_digest", "target_record_id", "migrated_at"],
  "properties": {
    "migration_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
    "source_schema_id": { "type": "string", "pattern": "^urn:open-android-intelligence:protocol:v0\\.9:[a-z][a-z0-9._-]*$" },
    "source_record_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" },
    "source_signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$", "format": "base64url-64" },
    "target_schema_id": { "type": "string", "pattern": "^urn:open-android-intelligence:protocol:v1:[a-z][a-z0-9._-]*$" },
    "target_record_digest": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/sha256_b64u" },
    "target_record_id": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/opaque_server_id" },
    "migrated_at": { "$ref": "urn:open-android-intelligence:protocol:v1:common#/$defs/timestamp" }
  },
  "unevaluatedProperties": false
}
