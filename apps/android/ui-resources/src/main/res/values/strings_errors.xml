<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ================================================================= -->
    <!-- 功能域: 异常处理与错误码映射 (Errors & Exceptions)                  -->
    <!-- 资源前缀: err_                                                    -->
    <!-- 适用场景: 结构化错误码映射、表单校验拦截、网络/IO/格式异常友好呈现    -->
    <!-- ================================================================= -->

    <!-- 兜底与全局未知异常 -->
    <string name="err_unknown">发生未知错误，请稍后重试</string>

    <!-- 网络与服务连接异常 -->
    <string name="err_network_timeout">连接服务器超时，请检查网络设置</string>
    <string name="err_network_unreachable">无法连接到服务器，请核对服务器地址是否正确</string>
    <string name="err_auth_failed">身份验证失败，请重新登录或重新配对设备</string>
    <string name="err_server_internal">服务器处理请求时发生内部错误</string>

    <!-- 表单与输入校验异常 -->
    <string name="err_field_required">该项内容不能为空</string>
    <string name="err_invalid_url">服务器地址格式不正确，应以 http:// 或 https:// 开头</string>
    <string name="err_invalid_port">端口号无效，应在 1 至 65535 之间</string>

    <!-- 备份恢复格式异常 (SettingsBackup 错误码映射专用) -->
    <string name="err_backup_invalid_format">备份文件格式无效或内容已损坏</string>
    <string name="err_backup_version_unsupported">不支持的备份文件版本：%1$s</string>
    <string name="err_backup_read_failed">读取备份文件失败，请确认文件完整性</string>
    <string name="err_backup_write_failed">写入备份文件失败，请检查存储空间</string>
</resources>
