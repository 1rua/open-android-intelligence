<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ================================================================= -->
    <!-- 功能域: 异常处理与错误码映射 (Errors & Exceptions)                  -->
    <!-- 资源前缀: err_                                                    -->
    <!-- 适用场景: 结构化错误码映射、表单校验拦截、网络/IO/格式异常友好呈现    -->
    <!-- ================================================================= -->

    <!-- 兜底与全局未知异常 -->
    <string name="err_unknown">发生未知错误，请稍后重试</string>

    <!-- 网络与服务连接异常 -->
    <string name="err_network_timeout">连接服务器超时，请检查网络设置</string>
    <string name="err_network_unreachable">无法连接到服务器，请核对服务器地址是否正确</string>
    <string name="err_auth_failed">身份验证失败，请重新登录或重新配对设备</string>
    <string name="err_server_internal">服务器处理请求时发生内部错误</string>

    <!-- 表单与输入校验异常 -->
    <string name="err_field_required">该项内容不能为空</string>
    <string name="err_invalid_url">服务器地址格式不正确，应以 http:// 或 https:// 开头</string>
    <string name="err_invalid_port">端口号无效，应在 1 至 65535 之间</string>

    <!-- 备份恢复格式异常 (SettingsBackup 错误码映射专用) -->
    <string name="err_backup_invalid_format">备份文件格式无效或内容已损坏</string>
    <string name="err_backup_version_unsupported">不支持的备份文件版本：%1$s</string>
    <string name="err_backup_read_failed">读取备份文件失败，请确认文件完整性</string>
    <string name="err_backup_write_failed">写入备份文件失败，请检查存储空间</string>
    <!-- 保留既有中文 message 的默认表现，界面通过结构化错误码读取这些资源。 -->
    <string name="err_backup_invalid_json">备份文件不是有效的 JSON。</string>
    <string name="err_backup_top_level_object_required">备份文件顶层必须是 JSON 对象。</string>
    <string name="err_backup_settings_required">备份文件缺少 settings。</string>
    <string name="err_backup_schema_version_required">备份文件缺少 schemaVersion。</string>
    <string name="err_backup_schema_version_newer">备份文件来自更新版本的 App（schemaVersion=%1$s），请先升级 App。</string>
    <string name="err_backup_schema_version_invalid">备份文件 schemaVersion 非法。</string>
    <string name="err_backup_exported_at_required">备份文件缺少导出时间。</string>
    <string name="err_backup_app_version_name_required">备份文件缺少 App 版本。</string>
    <string name="err_backup_app_version_code_required">备份文件缺少 App versionCode。</string>
    <string name="err_backup_migration_unavailable">备份文件版本 %1$s 无法迁移到当前版本。</string>
    <string name="err_backup_section_object_required">设置项 %1$s 必须是 JSON 对象。</string>
    <string name="err_backup_field_string_required">字段 %1$s 必须是字符串。</string>
    <string name="err_backup_field_boolean_required">字段 %1$s 必须是布尔值。</string>
    <string name="err_backup_field_integer_required">字段 %1$s 必须是整数。</string>
    <string name="err_backup_field_array_required">字段 %1$s 必须是数组。</string>
    <string name="err_backup_field_strings_required">字段 %1$s 只能包含字符串。</string>
    <string name="err_backup_field_objects_required">字段 %1$s 只能包含对象。</string>
    <string name="err_backup_field_object_required">字段 %1$s 必须是对象。</string>
    <string name="err_backup_field_value_invalid">%1$s：%2$s</string>
    <string name="err_backup_no_restorable_settings">备份文件中没有可恢复的设置。</string>
    <string name="err_backup_file_too_large">文件过大，不是本 App 导出的设置文件。</string>
</resources>
