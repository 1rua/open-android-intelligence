    <!-- 引导页权限目录说明项 (PermissionCatalog) -->
    <string name="perm_catalog_notifications_title">通知</string>
    <string name="perm_catalog_notifications_desc">接收助手回复、生成完成与审批提醒。关闭后仍可使用，但需要保持应用在前台。</string>
    <string name="perm_catalog_microphone_title">麦克风</string>
    <string name="perm_catalog_microphone_desc">发送语音消息。仅在按下录音时采集，音频直接发往你的助手，不进行转录。</string>
    <string name="perm_catalog_screen_capture_title">屏幕采集</string>
    <string name="perm_catalog_screen_capture_desc">圈选屏幕内容发送给助手。</string>
    <string name="perm_catalog_assistant_role_title">默认数字助理</string>
    <string name="perm_catalog_assistant_role_desc">把这台设备上的数字助理设为 OAI。设置后可用系统 Assist 手势在任何应用中唤起助手；不设置时仍可在应用内正常对话，只是没有跨应用入口。</string>
    <string name="perm_catalog_sms_title">短信读取</string>
    <string name="perm_catalog_sms_desc">用于让助手查询短信验证码与消息通知。</string>
    <string name="perm_catalog_call_log_title">通话与电话状态</string>
    <string name="perm_catalog_call_log_desc">用于让助手查询通话记录或检测来电状态，协助进行电话管理。</string>
    <string name="perm_catalog_notification_access_title">通知使用权</string>
    <string name="perm_catalog_notification_access_desc">用于让助手查询系统其它应用通知与提醒，需在系统设置中手动开启。</string>

    <!-- 权限与授权区别常驻说明 -->
    <string name="perm_notice_title">权限 ≠ 授权</string>
    <string name="perm_intro_body">以下权限只影响对应功能。可选权限跳过不影响登录与对话；设备能力由本机决定：插件启用后默认开启，仍需满足系统权限和本地范围设置。</string>
    <string name="perm_notice_body">设备能力由 Android 本机决定，可在插件管理中关闭；已关闭的设置会保留。旧设置需先在本机复核。系统权限、通知读取范围、屏幕许可、后台许可和敏感操作确认仍分别检查，不需要再为服务器账号单独开启设备能力。</string>

    <!-- 设备能力系统权限要求与手动引导 (DeviceCapabilityPermissions) -->
    <string name="perm_req_sms_title">短信读取</string>
    <string name="perm_req_sms_purpose">读取本机短信内容供助手查询。不授权时短信能力不可用，其他功能不受影响。</string>
    <string name="perm_req_call_log_title">通话记录读取</string>
    <string name="perm_req_call_log_purpose">读取本机通话记录供助手查询。不授权时通话记录能力不可用。</string>
    <string name="perm_req_notification_access_title">通知使用权</string>
    <string name="perm_req_notification_access_purpose">读取新到通知的内容供助手处理。需要先在系统「通知使用权」里允许本应用。</string>
    <string name="perm_req_accessibility_title">无障碍服务</string>
    <string name="perm_req_accessibility_capture_purpose">读取屏幕内容、执行点按等操作，并在开启后按需截取屏幕画面。必须在系统无障碍设置里开启本应用的服务。</string>
    <string name="perm_req_accessibility_control_purpose">读取屏幕内容并执行点按等操作。必须在系统无障碍设置里开启本应用的服务。</string>
    <string name="perm_req_screen_projection_fallback_title">屏幕共享（备用）</string>
    <string name="perm_req_screen_projection_title">屏幕共享</string>
    <string name="perm_req_screen_projection_fallback_purpose">仅当无障碍截图不可用、且你明确同意时才需要。每次屏幕共享会话都要单独确认。</string>
    <string name="perm_req_screen_projection_purpose">当前系统不支持无障碍截图，只能通过系统屏幕共享授权截图。每次会话都要单独确认。</string>
    <string name="perm_guidance_accessibility">无法自动打开无障碍设置。请手动进入：系统设置 → 无障碍 → 已下载的服务 / 已安装的应用 → 找到本应用 → 开启，并确认服务显示「已连接」。</string>
    <string name="perm_guidance_notification_access">无法自动打开通知使用权设置。请手动进入：系统设置 → 通知 → 通知使用权（或「设备和应用通知」→ 特殊访问权限）→ 找到本应用 → 允许。</string>
    <string name="perm_guidance_screen_projection">屏幕共享需要一次系统授权。请在应用内重新点击「屏幕共享」发起；若系统未提供录屏服务，无障碍截图仍是可用路径。</string>
    <string name="perm_guidance_runtime_format">无法自动申请该权限。请手动进入：系统设置 → 应用 → 本应用 → 权限 → 允许%1$s。</string>

