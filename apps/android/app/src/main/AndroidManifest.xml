<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        屏幕圈选的截图来源（MediaProjection）：Android 14+ 要求投影会话跑在
        foregroundServiceType="mediaProjection" 的前台服务里，且必须由用户经
        系统授权对话框显式授予；未授权时圈选明确降级为不可用，绝无静默采集。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        usesCleartextTraffic 允许用户显式输入的 http:// 明文 Gateway（ADR 0047）。
        HTTPS 仍是默认链路：已固定 TLS 身份的连接不会被允许降级到明文，
        明文连接会持续显示未加密警告，界面不会把它标成已核验的身份。
    -->
    <application
        android:name=".OpenAndroidIntelligenceApplication"
        android:allowBackup="false"
        android:label="Open Android Intelligence"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenAndroidIntelligence"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OpenAndroidIntelligence">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.openandroidintelligence.capability.MediaProjectionCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
            仅供 JVM 单元测试（Robolectric + Compose createComposeRule）解析的
            宿主 Activity。androidx.compose.ui:ui-test-manifest 的清单只在 debug
            变体的单元测试合并中出现（release/play 变体拿不到，导致
            "Unable to resolve activity for Intent ... ComponentActivity"）；
            显式声明使 full/play × debug/release 四个变体的单元测试行为一致。
            exported=false 且生产代码从不启动它，不构成额外攻击面。
        -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            tools:replace="android:exported" />
    </application>
</manifest>
