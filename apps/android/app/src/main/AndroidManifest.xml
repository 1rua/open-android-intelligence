<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        屏幕圈选的截图来源（MediaProjection）：Android 14+ 要求投影会话跑在
        foregroundServiceType="mediaProjection" 的前台服务里，且必须由用户经
        系统授权对话框显式授予；未授权时圈选明确降级为不可用，绝无静默采集。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- 提供常见已安装应用的可见范围，查询时仍保留系统允许访问的其他应用。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        usesCleartextTraffic 允许用户显式输入的 http:// 明文 Gateway（ADR 0047）。
        HTTPS 仍是默认链路：已固定 TLS 身份的连接不会被允许降级到明文，
        明文连接会持续显示未加密警告，界面不会把它标成已核验的身份。
    -->
    <application
        android:name=".OpenAndroidIntelligenceApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="OAI"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenAndroidIntelligence"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OpenAndroidIntelligence">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="oai" android:host="pair" />
            </intent-filter>
        </activity>
        <activity
            android:name=".BubbleConversationActivity"
            android:label="Agent 会话"
            android:exported="false"
            android:resizeableActivity="true"
            android:allowEmbedded="true"
            android:documentLaunchMode="always"
            android:launchMode="standard"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OpenAndroidIntelligence" />
        <service
            android:name=".AgentSessionForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="com.openandroidintelligence.capability.MediaProjectionCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service android:name=".assistant.AssistantBridgeService" android:exported="false" />
        <!--
            系统数字助理（VoiceInteractionService / VoiceInteractionSessionService）。

            声明必须放在 app 模块：`android.voice_interaction` 元数据里的 sessionService
            要求写成 `<applicationId>/<类全名>` 的扁平组件名，只有这里确定最终
            applicationId；写成短类名时 ComponentName.unflattenFromString 返回 null，
            系统会把应用判成 unqualified，用户在「默认数字助理」里根本看不到本应用。

            会话服务必须 exported=true（系统以不同 UID 绑定），权限仍由
            BIND_VOICE_INTERACTION 收口，只有系统能绑定。
        -->
        <!--
            未设为默认数字助理时的 ASSIST 兜底入口：浮在其他 App 之上（半透明窗口 + 系统遮罩），
            复用同一套 Compose 助理界面，而不是另起一个全屏页。
        -->
        <activity
            android:name="com.openandroidintelligence.assistant.AssistantActivity"
            android:process=":assistant_session"
            android:exported="true"
            android:theme="@style/Theme.OpenAndroidIntelligence.AssistantOverlay"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service
            android:name="com.openandroidintelligence.assistant.AssistantVoiceService"
            android:process=":assistant_keeper"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>
        <service
            android:name="com.openandroidintelligence.assistant.AssistantSessionService"
            android:process=":assistant_session"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!--
            数字助理资格判定要求存在 recognitionService（见 voice_interaction_service.xml）。
            本应用不做系统级语音识别，服务里明确返回「未接入」，不伪造识别结果。
        -->
        <service
            android:name="com.openandroidintelligence.assistant.AssistantRecognitionService"
            android:process=":assistant_keeper"
            android:exported="true"
            android:permission="android.permission.BIND_SPEECH_RECOGNITION" />
        <service android:name=".plugins.PluginTimerService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
        <service
            android:name=".GatewayAccountAuthenticatorService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCOUNT_AUTHENTICATOR">
            <intent-filter><action android:name="android.accounts.AccountAuthenticator" /></intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator" android:resource="@xml/gateway_account_authenticator" />
        </service>

        <!--
            仅供 JVM 单元测试（Robolectric + Compose createComposeRule）解析的
            宿主 Activity。androidx.compose.ui:ui-test-manifest 的清单只在 debug
            变体的单元测试合并中出现（release/play 变体拿不到，导致
            "Unable to resolve activity for Intent ... ComponentActivity"）；
            显式声明使 full/play × debug/release 四个变体的单元测试行为一致。
            exported=false 且生产代码从不启动它，不构成额外攻击面。
        -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            tools:replace="android:exported" />
    </application>
</manifest>
