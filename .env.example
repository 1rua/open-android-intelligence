# Open Android Intelligence 本地开发环境变量示例文件。
# 复制本文件为 `.env` 后按需修改；请勿将真实密钥、口令或个人环境路径提交到仓库。
# 注意不同工具的相对路径基准目录不同，已按各自执行基准给出示例。

# ==============================================================================
# 插件构建与签名配置
# ==============================================================================

# 插件打包签名私钥文件路径（32 字节 Ed25519 原始种子文件）。
# 通过 `npm run build:android-plugins --prefix plugin-tooling` 调用时相对于 `plugin-tooling/` 解析
OPEN_ANDROID_INTELLIGENCE_PLUGIN_SIGNING_KEY_FILE=../.secrets/plugin-signing.key

# Android 应用打包时内置的已签名 `.alp` 插件目录。
# 由 apps/android/app/build.gradle.kts 通过 `file(...)` 相对于 `apps/android/app/` 目录解析
OAI_BUNDLED_PLUGINS_DIR=../../../plugins/dist/signed-plugins

# ==============================================================================
# Android Release 签名配置（勿填写真实口令）
# ==============================================================================

# Android Release 签名密钥库文件路径（由 apps/android/app/build.gradle.kts 相对于 `apps/android/app/` 解析）
OAI_RELEASE_KEYSTORE=../../../.secrets/oai-release.keystore

# Android Release 密钥库密码占位符（对应 apps/android/app/build.gradle.kts 读取的 OAI_RELEASE_STORE_PASSWORD）
OAI_RELEASE_STORE_PASSWORD=change-me-keystore-password

# Android Release 签名密钥别名占位符
OAI_RELEASE_KEY_ALIAS=oai-release

# Android Release 签名密钥密码占位符
OAI_RELEASE_KEY_PASSWORD=change-me-key-password

# ==============================================================================
# 本地工具链与模拟器 / ADB 调试配置
# ==============================================================================

# 本地离线工具链目录（在仓库根目录执行时解析；包含 JDK、Android SDK、NDK、Gradle 缓存等）
OAI_TOOLCHAINS_ROOT=./.toolchains

# Android SDK 根目录（未设置时脚本默认回退到 $OAI_TOOLCHAINS_ROOT/android-sdk）
ANDROID_HOME=./.toolchains/android-sdk

# JDK 根目录（未设置时构建脚本默认回退到 $OAI_TOOLCHAINS_ROOT 下对应的 JDK 目录）
JAVA_HOME=./.toolchains/jdk-21-extract/jbrsdk_jcef-21.0.10-linux-x64-b1163.110

# 目标调试设备或模拟器序列号（collect-first-draw.py 等验证脚本默认使用 127.0.0.1:5563）
ADB_SERIAL=127.0.0.1:5563

# 隔离调试用 ADB Server 端口（避免与默认 5037 冲突，默认 5038）
ADB_SERVER_PORT=5038

# 本地验证模拟器名称与控制台端口（run-emulator.sh 使用）
AVD_NAME=oai-local-first-20261103
ADB_EMULATOR_PORT=5562
