{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-android-intelligence.dev/schemas/gateway/v2/device-request.schema.json",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "capability",
        "provider",
        "parameters",
        "risk",
        "grantRevision",
        "createdAt",
        "expiresAt",
        "requiresForegroundConfirmation"
      ],
      "properties": {
        "requestId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pluginId",
            "authorKeyId"
          ],
          "properties": {
            "pluginId": {
              "type": "string",
              "minLength": 1
            },
            "authorKeyId": {
              "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/prefixedSha256"
            }
          }
        },
        "parameters": {
          "$comment": "Dispatch by the negotiated capability id and version and validate again with its capability sub-Schema; missing sub-Schema must fail closed.",
          "type": "object"
        },
        "risk": {
          "enum": [
            "read",
            "sync",
            "write",
            "high-privilege-ephemeral"
          ]
        },
        "grantRevision": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/utcMillis"
        },
        "expiresAt": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/utcMillis"
        },
        "requiresForegroundConfirmation": {
          "type": "boolean"
        },
        "caller": {
          "$ref": "#/$defs/caller"
        }
      },
      "$comment": "caller is present on all new REST/CLI/MCP requests. Optional only to decode persisted pre-upgrade requests without inventing a declaration."
    },
    "result": {
      "$comment": "Contract §10: POST /device-requests/{requestId}/result carries result as { outcome, data? }. outcome_unknown must not carry data.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome"
      ],
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "const": "outcome_unknown"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "succeeded",
                "failed",
                "denied",
                "cancelled"
              ]
            },
            "data": {
              "type": "object"
            }
          }
        }
      ],
      "properties": {
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "denied",
            "cancelled",
            "outcome_unknown"
          ]
        },
        "data": {
          "type": "object"
        }
      }
    },
    "resultRequest": {
      "$comment": "Contract §10: the result submission body is claimId + grantRevision + result, nothing else.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "grantRevision",
        "result"
      ],
      "properties": {
        "claimId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "grantRevision": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "$ref": "#/$defs/result"
        }
      }
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentName",
        "purpose"
      ],
      "properties": {
        "agentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
        }
      }
    },
    "endpointRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coreInstanceId",
        "accountScope",
        "endpointId",
        "generation"
      ],
      "properties": {
        "coreInstanceId": {
          "type": "string",
          "pattern": "^core_[0-9a-f]{32}$"
        },
        "accountScope": {
          "type": "string",
          "pattern": "^acct_[0-9a-f]{32}$"
        },
        "endpointId": {
          "type": "string",
          "pattern": "^endpoint_[0-9a-f]{32}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "endpointRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registrationKey",
        "label"
      ],
      "properties": {
        "registrationKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        }
      }
    },
    "pushDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "route",
        "eventType",
        "occurredAt",
        "expiresAt",
        "payload"
      ],
      "properties": {
        "eventId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "route": {
          "$ref": "#/$defs/endpointRoute"
        },
        "eventType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "occurredAt": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/utcMillis"
        },
        "expiresAt": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/utcMillis"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "pushAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId"
      ],
      "properties": {
        "eventId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        }
      }
    },
    "pushRevoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route"
      ],
      "properties": {
        "route": {
          "$ref": "#/$defs/endpointRoute"
        },
        "eventIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
          },
          "$comment": "Select only events whose local consent was withdrawn. Omitting eventIds revokes all pending events on this exact route and is reserved for explicit endpoint removal. Unknown event IDs are idempotent no-ops."
        }
      }
    },
    "authorizationProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "awaiting_confirmation",
            "executing"
          ]
        }
      }
    }
  }
}
