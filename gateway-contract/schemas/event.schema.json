{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-android-intelligence.dev/schemas/gateway/v2/event.schema.json",
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlationId", "occurredAt", "payload"],
      "properties": {
        "correlationId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "occurredAt": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/utcMillis"
        },
        "type": {
          "$comment": "Event type is carried by the validated SSE event line (contract §9); this mirror is optional and lists the V2 event types.",
          "type": "string",
          "enum": [
            "conversation.message.delta",
            "conversation.message.completed",
            "conversation.command.result",
            "conversation.approval.requested",
            "conversation.approval.resolved",
            "conversation.title.updated",
            "device.requested",
            "device.request.cancel.requested",
            "pairing.grant.changed",
            "session.revoked",
            "attachment.acknowledged",
            "gateway.notice"
          ]
        },
        "payload": {
          "$comment": "Dispatch by the validated SSE event type (the dispatch key is the eventType string in dispatched-schema-fixtures.json, NOT a $defs key) and validate again with its event-specific sub-Schema; missing sub-Schema must fail closed. Normative copies of the payload shapes live in $defs.sessionRevokedPayload and $defs.pairingGrantChangedPayload.",
          "type": "object"
        }
      }
    },
    "sessionRevokedPayload": {
      "$comment": "Normative copy for eventType 'session.revoked' (contract §9). Notification only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId"],
      "properties": {
        "sessionId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "deviceId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        }
      }
    },
    "pairingGrantChangedPayload": {
      "$comment": "Normative copy for eventType 'pairing.grant.changed' (contract §9/§11). Notification only: the event must never widen the Android-local authoritative grant record; decisions still travel the request path and stale revisions still return GRANT_STALE.",
      "type": "object",
      "additionalProperties": false,
      "required": ["grantRevision"],
      "properties": {
        "grantRevision": { "type": "integer", "minimum": 0 },
        "pluginId": { "type": "string", "minLength": 1 },
        "authorKeyId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/prefixedSha256"
        },
        "capabilityId": { "type": "string", "minLength": 1 },
        "capabilityVersion": { "type": "string", "minLength": 1 },
        "grantDigest": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/prefixedSha256"
        }
      }
    }
  }
}
