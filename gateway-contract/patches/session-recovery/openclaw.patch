diff --git a/test/refresh-replay.test.ts b/test/refresh-replay.test.ts
new file mode 100644
index 0000000..a96be51
--- /dev/null
+++ b/test/refresh-replay.test.ts
@@ -0,0 +1,133 @@
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { createGatewayCore } from "../src/core/gateway-core.js";
+
+const key = Buffer.alloc(32, 0x42);
+const setup = async () => {
+  const root = mkdtempSync(join(tmpdir(), "refresh-replay-"));
+  const core = createGatewayCore({ storageRoot: root, attachmentMasterKey: key });
+  const account = await core.openGatewayAccount("acct_alice");
+  account.credentials.setPassword("password");
+  const first = account.sessions.createPasswordSession({ username: "alice", password: "password", installation: {
+    installationId: "install_one", displayName: "phone", devicePublicKey: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
+  }, correlationId: "login" });
+  const input = { refreshCredential: first.refreshCredential, installationId: "install_one", deviceId: first.deviceId, correlationId: "refresh", operationId: "refresh_operation" };
+  return { root, account, first, input };
+};
+it("replays an encrypted refresh after restart, conflicts on changed input, and bounds the ledger", async () => {
+  const { root, account, first, input } = await setup();
+  const rotated = account.sessions.refresh(input);
+  const disk = JSON.stringify(account.store.database.prepare("SELECT * FROM refresh_replay").all());
+  expect(disk).toContain("aead-v1:");
+  expect(disk).not.toContain(rotated.refreshCredential);
+  expect(disk).not.toContain(rotated.accessToken);
+  account.close();
+  const reopened = await createGatewayCore({ storageRoot: root, attachmentMasterKey: key }).openGatewayAccount("acct_alice");
+  expect(reopened.sessions.refresh(input)).toEqual(rotated);
+  expect(() => reopened.sessions.refresh({ ...input, refreshCredential: rotated.refreshCredential })).toThrow("IDEMPOTENCY_CONFLICT");
+  expect(reopened.sessions.activeRefreshCredentialCount(first.deviceId)).toBe(1);
+  reopened.sessions.refresh({ ...input, refreshCredential: rotated.refreshCredential, operationId: "refresh_next" });
+  expect(reopened.store.database.prepare("SELECT * FROM refresh_replay").all()).toHaveLength(1);
+  expect(() => reopened.sessions.refresh(input)).toThrow("REFRESH_REUSED");
+  expect(reopened.sessions.activeRefreshCredentialCount(first.deviceId)).toBe(0);
+  reopened.close();
+});
+for (const revoke of ["refresh", "session", "device", "reset", "reuse"] as const) it(`does not replay after ${revoke} revocation`, async () => {
+  const { account, input, first } = await setup();
+  const rotated = account.sessions.refresh(input);
+  if (revoke === "refresh") account.sessions.revokeRefreshCredentials(first.deviceId, "logout");
+  if (revoke === "session") account.sessions.revokeSession(rotated.sessionId, "logout");
+  if (revoke === "device") account.store.database.prepare("DELETE FROM device_keys WHERE device_id=?").run(first.deviceId);
+  if (revoke === "reset") account.store.database.exec("UPDATE refresh_credentials SET status='revoked'");
+  if (revoke === "reuse") expect(() => account.sessions.refresh({ ...input, operationId: "different" })).toThrow("REFRESH_REUSED");
+  expect(() => account.sessions.refresh(input)).toThrow();
+  account.close();
+});
+it("rolls rotation and replay back together on sealing failure", async () => {
+  const { account, input, first } = await setup();
+  const failedStore = { ...account.store, sealJson: () => { throw new Error("ATTACHMENT_STORAGE_UNAVAILABLE"); } };
+  const { SessionService } = await import("../src/core/session-service.js");
+  const sessions = new SessionService("acct_alice", failedStore, account.audit, account.events, account.credentials);
+  expect(() => sessions.refresh(input)).toThrow("ATTACHMENT_STORAGE_UNAVAILABLE");
+  expect(account.sessions.activeRefreshCredentialCount(first.deviceId)).toBe(1);
+  expect(account.store.database.prepare("SELECT status FROM refresh_credentials").all()).toEqual([{ status: "active" }]);
+  account.close();
+});
+
+it("negotiates and replays over HTTP with a fresh negotiation, validates wire IDs, and keeps metadata out of JSON", async () => {
+  const { createServer } = await import("node:http");
+  const { createGatewayRoutes } = await import("../src/http/routes.js");
+  const { coreSchemaHash } = await import("../gateway-contract/src/core-schema-hash.js");
+  const { default: vectors } = await import("../gateway-contract/vectors/protocol-negotiation.json", { with: { type: "json" } });
+  const { root, account, first } = await setup();
+  account.close();
+  let core = createGatewayCore({ storageRoot: root, attachmentMasterKey: key });
+  const server = createServer((req, res) => {
+    const route = createGatewayRoutes({ core, hostVersion: "2026.7.1" }).find(route => route.path === req.url)!;
+    void route.handler(req, res);
+  });
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+  const origin = `http://127.0.0.1:${(server.address() as { port: number }).port}/open-android-intelligence/v2`;
+  const post = (path: string, body: unknown, headers: Record<string, string> = {}) => fetch(origin + path, { method: "POST", body: JSON.stringify(body), headers: { "content-type": "application/json", ...headers } });
+  const rawPost = (path: string, body: unknown, pairs: string[]) => new Promise<number>((resolve, reject) => {
+    const payload = JSON.stringify(body);
+    void import("node:http").then(({ request }) => {
+      const outgoing = request(origin + path, { method: "POST", headers: ["Host", new URL(origin).host, "Content-Type", "application/json", "Content-Length", String(Buffer.byteLength(payload)), ...pairs] }, incoming => {
+        incoming.resume();
+        incoming.on("end", () => resolve(incoming.statusCode!));
+      });
+      outgoing.on("error", reject);
+      outgoing.end(payload);
+    }).catch(reject);
+  });
+  const negotiation = structuredClone(vectors.cases[0]!.input.value!) as Record<string, any>;
+  negotiation.schemaHashes.core = coreSchemaHash();
+  negotiation.client.installationId = "install_one";
+  const capability = "x-open-android-intelligence-refresh-replay";
+  try {
+    for (const value of ["v2", "v1, v1"]) {
+      expect(await rawPost("/negotiate", negotiation, [capability, value])).toBe(400);
+    }
+    expect(await rawPost("/negotiate", negotiation, [capability, "v1", capability, "v1"])).toBe(400);
+    let response = await post("/negotiate", negotiation, { [capability]: "v1" });
+    expect(response.status).toBe(200);
+    expect(response.headers.get(capability)).toBe("v1");
+    expect(await response.text()).not.toContain("responseHeaders");
+    const body = { accountId: "acct_alice", installationId: "install_one", deviceId: first.deviceId, refreshCredential: first.refreshCredential, negotiationId: negotiation.negotiationId };
+    response = await post("/sessions/refresh", body, { "Idempotency-Key": "bad key" });
+    expect(response.status).toBe(400);
+    expect(await rawPost("/sessions/refresh", body, ["Idempotency-Key", "refresh_http", "Idempotency-Key", "refresh_http"])).toBe(400);
+    expect(await rawPost("/sessions/refresh", body, ["Idempotency-Key", "refresh_http, refresh_http"])).toBe(400);
+    response = await post("/sessions/refresh", body, { "Idempotency-Key": "refresh_http" });
+    expect(response.status).toBe(200);
+    const original = (await response.json() as any).data;
+    const changed = await core.openGatewayAccount("acct_alice");
+    changed.store.database.prepare("UPDATE device_keys SET grant_revision=7 WHERE device_id=?").run(first.deviceId);
+    changed.close();
+    core = createGatewayCore({ storageRoot: root, attachmentMasterKey: key });
+    negotiation.negotiationId = "neg_after_restart";
+    await (await post("/negotiate", negotiation, { [capability]: "v1" })).text();
+    response = await post("/sessions/refresh", { ...body, negotiationId: negotiation.negotiationId }, { "Idempotency-Key": "refresh_http" });
+    expect(response.status).toBe(200);
+    expect((await response.json() as any).data).toEqual({ ...original, grantRevision: 7 });
+    core = createGatewayCore({ storageRoot: root });
+    response = await post("/negotiate", negotiation, { [capability]: "v1" });
+    expect(response.headers.get(capability)).toBeNull();
+    await response.text();
+  } finally {
+    await new Promise<void>(resolve => { server.close(() => resolve()); server.closeAllConnections(); });
+  }
+});
+
+it("does not let a mismatched binding or corrupt encrypted result authorize a replay", async () => {
+  const { account, input, first } = await setup();
+  account.sessions.refresh(input);
+  expect(() => account.sessions.refresh({ ...input, installationId: "install_other" })).toThrow("AUTHENTICATION_FAILED");
+  expect(() => account.sessions.refresh({ ...input, deviceId: "dev_other" })).toThrow("AUTHENTICATION_FAILED");
+  account.store.database.prepare("UPDATE refresh_replay SET outcome_json='aead-v1:broken'").run();
+  expect(() => account.sessions.refresh(input)).toThrow("ATTACHMENT_STORAGE_UNAVAILABLE");
+  expect(account.sessions.activeRefreshCredentialCount(first.deviceId)).toBe(1);
+  account.close();
+});
