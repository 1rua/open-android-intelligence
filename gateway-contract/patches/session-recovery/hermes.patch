+def _refresh_replay_headers(request: Any, target: str) -> dict[str, str]:
+    """Optional pre-auth replay singletons are proven before framework folding."""
+    headers = dict(_get(request, "headers", default={}) or {})
+    name = ("x-open-android-intelligence-refresh-replay" if target == "/open-android-intelligence/v2/negotiate"
+            else "idempotency-key" if target == "/open-android-intelligence/v2/sessions/refresh" else None)
+    if name is None:
+        return headers
+    raw = _get(request, "rawHeaders", "raw_headers")
+    if raw is None:
+        if any(key.lower() == name for key in headers):
+            raise ValueError("raw replay headers unavailable")
+        return headers
+    items = list(raw)
+    if items and isinstance(items[0], (tuple, list)):
+        pairs = items
+    else:
+        if len(items) % 2:
+            raise ValueError("malformed raw headers")
+        pairs = list(zip(items[::2], items[1::2]))
+    values = [value for key, value in pairs if str(key).lower() == name]
+    if len(values) > 1 or (not values and any(key.lower() == name for key in headers)):
+        raise ValueError("duplicate or missing replay header")
+    headers = {key: value for key, value in headers.items() if key.lower() != name}
+    if values:
+        value = values[0]
+        if not isinstance(value, str) or (value != "v1" if name != "idempotency-key" else re.fullmatch(r"[A-Za-z0-9._~-]{1,128}", value) is None):
+            raise ValueError("invalid replay header")
+        headers[name] = value
+    return headers
+
