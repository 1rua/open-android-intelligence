diff --git a/tests/test_refresh_replay.py b/tests/test_refresh_replay.py
new file mode 100644
index 0000000..de43a29
--- /dev/null
+++ b/tests/test_refresh_replay.py
@@ -0,0 +1,112 @@
+import pytest
+from open_android_intelligence_gateway.core import create_gateway_core, GatewayError
+from test_support import make_secret_store
+
+INSTALLATION = {"installationId": "install_one", "displayName": "phone", "devicePublicKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}
+
+def setup(tmp_path):
+    secret_store = make_secret_store()
+    core = create_gateway_core(storage_root=tmp_path, secret_store=secret_store, credential_verifier=lambda *args: True)
+    account = core.open_gateway_account("acct_alice")
+    first = account.sessions.create_password_session("alice", "password", INSTALLATION, "login")
+    inputs = dict(refresh_credential=first["refreshCredential"], installation_id="install_one", device_id=first["deviceId"], correlation_id="refresh", operation_id="refresh_operation")
+    return core, account, first, inputs
+
+def test_replay_survives_restart_is_encrypted_conflicts_and_is_bounded(tmp_path):
+    core, account, first, inputs = setup(tmp_path)
+    rotated = account.sessions.refresh(**inputs)
+    rows = str([tuple(row) for row in account.store.database.execute("SELECT * FROM refresh_replay")])
+    assert "aead-v1:" in rows
+    assert rotated["refreshCredential"] not in rows and rotated["accessToken"] not in rows
+    account.close()
+    core = create_gateway_core(storage_root=tmp_path, secret_store=core.secret_store, credential_verifier=lambda *args: True)
+    account = core.open_gateway_account("acct_alice")
+    assert account.sessions.refresh(**inputs) == rotated
+    with pytest.raises(GatewayError, match="IDEMPOTENCY_CONFLICT"):
+        account.sessions.refresh(**dict(inputs, refresh_credential=rotated["refreshCredential"]))
+    assert account.sessions.active_refresh_credential_count(first["deviceId"]) == 1
+    account.sessions.refresh(**dict(inputs, refresh_credential=rotated["refreshCredential"], operation_id="refresh_next"))
+    assert account.store.database.execute("SELECT COUNT(*) FROM refresh_replay").fetchone()[0] == 1
+    with pytest.raises(GatewayError, match="REFRESH_REUSED"):
+        account.sessions.refresh(**inputs)
+    assert account.sessions.active_refresh_credential_count(first["deviceId"]) == 0
+    account.close()
+
+@pytest.mark.parametrize("revoke", ["refresh", "session", "device", "reset", "reuse"])
+def test_revocation_blocks_replay(tmp_path, revoke):
+    _, account, first, inputs = setup(tmp_path)
+    rotated = account.sessions.refresh(**inputs)
+    if revoke == "refresh": account.sessions.revoke_refresh_credentials(first["deviceId"], "logout")
+    if revoke == "session": account.sessions.revoke_session(rotated["sessionId"], "logout")
+    if revoke == "device": account.store.database.execute("DELETE FROM device_keys WHERE device_id=?", (first["deviceId"],))
+    if revoke == "reset": account.store.database.execute("UPDATE refresh_credentials SET status='revoked'")
+    if revoke == "reuse":
+        with pytest.raises(GatewayError, match="REFRESH_REUSED"):
+            account.sessions.refresh(**dict(inputs, operation_id="different"))
+    with pytest.raises(GatewayError): account.sessions.refresh(**inputs)
+    account.close()
+
+def test_sealing_failure_rolls_back_rotation(tmp_path):
+    _, account, first, inputs = setup(tmp_path)
+    def fail(*args): raise GatewayError("ATTACHMENT_STORAGE_UNAVAILABLE")
+    account.store.seal_json = fail
+    with pytest.raises(GatewayError, match="ATTACHMENT_STORAGE_UNAVAILABLE"):
+        account.sessions.refresh(**inputs)
+    assert [row[0] for row in account.store.database.execute("SELECT status FROM refresh_credentials")] == ["active"]
+    account.close()
+
+def test_http_capability_and_refresh_replay_after_new_negotiation(tmp_path):
+    import copy
+    import json
+    from open_android_intelligence_gateway.http import create_gateway_routes, HostApiCompatibility
+    from test_support import contract_root
+    core, account, first, _ = setup(tmp_path)
+    account.close()
+    core.tls_spki_sha256 = "sha256:" + "a" * 64
+    host_api = HostApiCompatibility("1.0.0", "1.0.0", "0123456789abcdef0123456789abcdef01234567")
+    def post(path, body, headers=None, raw_headers=None):
+        routes = create_gateway_routes(core=core, host_version="1.0.0", host_api=host_api)
+        route = next(r for r in routes if r.path == "/open-android-intelligence/v2" + path)
+        return route._handle_raw({"method": "POST", "url": route.path, "body": json.dumps(body).encode(), "headers": headers or {}, "rawHeaders": list((headers or {}).items()) if raw_headers is None else raw_headers})
+    negotiation = copy.deepcopy(json.loads((contract_root() / "vectors/protocol-negotiation.json").read_text())["cases"][0]["input"]["value"])
+    negotiation["schemaHashes"]["core"] = core.contracts.core_schema_hash
+    negotiation["client"]["installationId"] = "install_one"
+    capability = "X-Open-Android-Intelligence-Refresh-Replay"
+    for value in ("v2", "v1, v1"):
+        assert post("/negotiate", negotiation, {capability: value})["statusCode"] == 400
+    assert post("/negotiate", negotiation, {capability: "v1"}, [(capability, "v1"), (capability, "v1")])["statusCode"] == 400
+    response = post("/negotiate", negotiation, {capability: "v1"})
+    assert response["statusCode"] == 200
+    assert response["headers"].get(capability.lower()) == "v1"
+    assert "response_headers" not in json.dumps(response["body"])
+    body = dict(accountId="acct_alice", installationId="install_one", deviceId=first["deviceId"], refreshCredential=first["refreshCredential"], negotiationId=negotiation["negotiationId"])
+    assert post("/sessions/refresh", body, {"Idempotency-Key": "bad key"})["statusCode"] == 400
+    assert post("/sessions/refresh", body, {"Idempotency-Key": "refresh_http"}, [("Idempotency-Key", "refresh_http"), ("Idempotency-Key", "refresh_http")])["statusCode"] == 400
+    assert post("/sessions/refresh", body, {"Idempotency-Key": "refresh_http, refresh_http"})["statusCode"] == 400
+    response = post("/sessions/refresh", body, {"Idempotency-Key": "refresh_http"})
+    assert response["statusCode"] == 200
+    original = response["body"]["data"]
+    changed = core.open_gateway_account("acct_alice")
+    changed.store.database.execute("UPDATE device_keys SET grant_revision=7 WHERE device_id=?", (first["deviceId"],))
+    changed.close()
+    core = create_gateway_core(storage_root=tmp_path, secret_store=core.secret_store, tls_spki_sha256="sha256:" + "a" * 64)
+    negotiation["negotiationId"] = "neg_after_restart"
+    assert post("/negotiate", negotiation, {capability: "v1"})["statusCode"] == 200
+    replay = post("/sessions/refresh", dict(body, negotiationId=negotiation["negotiationId"]), {"Idempotency-Key": "refresh_http"})
+    assert replay["statusCode"] == 200
+    assert replay["body"]["data"] == dict(original, grantRevision=7)
+    core = create_gateway_core(storage_root=tmp_path, tls_spki_sha256="sha256:" + "a" * 64)
+    assert capability.lower() not in post("/negotiate", negotiation, {capability: "v1"})["headers"]
+
+def test_binding_and_ciphertext_cannot_be_substituted(tmp_path):
+    _, account, first, inputs = setup(tmp_path)
+    account.sessions.refresh(**inputs)
+    with pytest.raises(GatewayError, match="AUTHENTICATION_FAILED"):
+        account.sessions.refresh(**dict(inputs, installation_id="install_other"))
+    with pytest.raises(GatewayError, match="AUTHENTICATION_FAILED"):
+        account.sessions.refresh(**dict(inputs, device_id="dev_other"))
+    account.store.database.execute("UPDATE refresh_replay SET outcome_json='aead-v1:broken'")
+    with pytest.raises(GatewayError, match="DECRYPTION_FAILED"):
+        account.sessions.refresh(**inputs)
+    assert account.sessions.active_refresh_credential_count(first["deviceId"]) == 1
+    account.close()
