{
  "name": "open-android-intelligence-protocol",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "test": "node --test tools/check-remote-sources.test.mjs && npm test --prefix plugin-tooling",
    "test:fast": "python3 tools/smart-test.py --level fast",
    "test:pr": "python3 tools/smart-test.py --level pr",
    "test:full": "python3 tools/smart-test.py --level full",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix plugin-tooling",
    "lock:check": "node tools/check-remote-sources.mjs",
    "ci:plan": "python3 tools/ci/impact.py",
    "test:remote": "node --experimental-vm-modules --test tools/remote/projection-scope.test.mjs tools/remote/media-source.test.mjs tools/remote/phone-mcp-interop.test.mjs",
    "test:phone-mcp:unit": "npm test --prefix integrations/oai-android-mcp",
    "test:phone-mcp:interop": "node tools/remote/phone-mcp-interop.ts",
    "test:phone-mcp": "npm run test:phone-mcp:unit && npm run test:phone-mcp:interop"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "fast-check": "4.9.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
